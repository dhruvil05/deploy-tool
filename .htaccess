# Apache can serve this folder. This tool can deploy to prod, so only this computer
# may open it.
Require local

Options -Indexes

# Only the app itself is served: index.php (or the folder, which opens it) and the files
# in assets/. Code, views, storage (FTP passwords), dot files (.git, .env) and the rest
# are refused. <If> is core Apache 2.4, so this works without mod_rewrite.
<If "%{REQUEST_URI} =~ m#/\.# || (%{REQUEST_URI} !~ m#/(index\.php)?$# && %{REQUEST_URI} !~ m#/assets/[\w-]+\.(css|js)$#)">
    Require all denied
</If>

# The same again for servers without <If> support in .htaccess files.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|views|storage)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^router\.php$ - [F,L]
</IfModule>
